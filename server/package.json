{
  "name": "food-saver-server",
  "version": "1.0.0",
  "private": true,
  "description": "Food Saver – Direct Connect API server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
