# ──────────────────────────────────────────────────
# Food Saver – Direct Connect  |  Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────

# ── General ──
NODE_ENV=development
PORT=3001

# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017/food-saver

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── JWT ──
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── CORS ──
CORS_ORIGIN=http://localhost:5173

# ── Cloudinary (image uploads) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Sentry (optional – leave blank to disable) ──
SENTRY_DSN_SERVER=
SENTRY_DSN_CLIENT=

# ── Rate Limiting ──
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_CLAIM_MAX=10
RATE_LIMIT_CLAIM_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000
